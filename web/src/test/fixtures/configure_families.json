[
 {
  "family": "distribution",
  "label": "Party vote share",
  "description": "Vote share for one or more party questions, split by the cuts you choose.",
  "fields": [
   {
    "path": "title",
    "label": "Title",
    "widget": "text",
    "required": true,
    "tier": "primary",
    "limits": {
     "max_length": 200
    },
    "multiple": false
   },
   {
    "path": "scenarios",
    "label": "Questions",
    "widget": "scenario_picker",
    "required": true,
    "tier": "primary",
    "show_when": {
     "op": "all",
     "of": [
      {
       "op": "not",
       "of": {
        "op": "equals",
        "path": "comparison.mode",
        "value": "compare"
       }
      },
      {
       "op": "not",
       "of": {
        "op": "equals",
        "path": "all_party_scenarios",
        "value": true
       }
      }
     ]
    },
    "options": {
     "source": "scenarios",
     "params": {
      "kind": "party"
     }
    },
    "limits": {
     "max_items": 12
    },
    "multiple": true
   },
   {
    "path": "surveys",
    "label": "Surveys",
    "help": "Empty uses the context's anchor round. One survey reads it; several are read side by side. With several surveys or questions, a split shows one at a time",
    "widget": "choice",
    "required": false,
    "tier": "primary",
    "show_when": {
     "op": "equals",
     "path": "comparison.mode",
     "value": "standalone"
    },
    "options": {
     "source": "surveys",
     "params": {}
    },
    "limits": {},
    "multiple": true
   },
   {
    "path": "anchor_round",
    "label": "Survey",
    "help": "Empty uses the context's anchor round",
    "widget": "choice",
    "required": false,
    "tier": "primary",
    "show_when": {
     "op": "not",
     "of": {
      "op": "equals",
      "path": "comparison.mode",
      "value": "standalone"
     }
    },
    "options": {
     "source": "surveys",
     "params": {
      "seat": false
     }
    },
    "limits": {},
    "multiple": false
   },
   {
    "path": "compare_round",
    "label": "Compared with survey",
    "help": "Empty uses the context's comparison round",
    "widget": "choice",
    "required": false,
    "tier": "more",
    "options": {
     "source": "surveys",
     "params": {
      "seat": false
     }
    },
    "limits": {},
    "multiple": false
   },
   {
    "path": "comparison.mode",
    "label": "Show",
    "help": "standalone: the anchor round; compare: anchor vs the comparison round (or two questions in one round); trend: the pipe rounds",
    "widget": "choice",
    "required": false,
    "tier": "primary",
    "choices": [
     "standalone",
     "compare",
     "trend"
    ],
    "default": "standalone",
    "limits": {},
    "multiple": false
   },
   {
    "path": "comparison.target.scenario",
    "label": "Question",
    "widget": "scenario_picker",
    "required": true,
    "tier": "primary",
    "show_when": {
     "op": "equals",
     "path": "comparison.mode",
     "value": "compare"
    },
    "options": {
     "source": "scenarios",
     "params": {
      "kind": "party"
     }
    },
    "limits": {},
    "multiple": false
   },
   {
    "path": "comparison.reference.scenario",
    "label": "Compared with",
    "help": "A party question compared with an opinion question is a Shakti comparison",
    "widget": "scenario_picker",
    "required": true,
    "tier": "primary",
    "show_when": {
     "op": "equals",
     "path": "comparison.mode",
     "value": "compare"
    },
    "options": {
     "source": "scenarios",
     "params": {
      "kind": "any"
     }
    },
    "limits": {},
    "multiple": false
   },
   {
    "path": "comparison.target.round",
    "label": "Question's round",
    "widget": "choice",
    "required": false,
    "tier": "more",
    "show_when": {
     "op": "equals",
     "path": "comparison.mode",
     "value": "compare"
    },
    "choices": [
     "anchor",
     "compare"
    ],
    "default": "anchor",
    "limits": {},
    "multiple": false
   },
   {
    "path": "comparison.reference.round",
    "label": "Compared with, round",
    "help": "Same round as the question: compare two questions within one round",
    "widget": "choice",
    "required": false,
    "tier": "more",
    "show_when": {
     "op": "equals",
     "path": "comparison.mode",
     "value": "compare"
    },
    "choices": [
     "anchor",
     "compare"
    ],
    "default": "compare",
    "limits": {},
    "multiple": false
   },
   {
    "path": "cuts",
    "label": "Split by",
    "help": "Each cut is its own table; fields in one cut are crossed. Empty = overall",
    "widget": "cut_builder",
    "required": false,
    "tier": "primary",
    "options": {
     "source": "fields",
     "params": {
      "use": "cut"
     }
    },
    "default": [
     []
    ],
    "limits": {
     "max_items": 8
    },
    "multiple": false
   },
   {
    "path": "all_party_scenarios",
    "label": "Every party question of the anchor round",
    "widget": "toggle",
    "required": false,
    "tier": "more",
    "show_when": {
     "op": "equals",
     "path": "comparison.mode",
     "value": "standalone"
    },
    "default": false,
    "limits": {},
    "multiple": false
   },
   {
    "path": "comparison.delta_measures",
    "label": "Change in",
    "widget": "choice",
    "required": false,
    "tier": "more",
    "show_when": {
     "op": "all",
     "of": [
      {
       "op": "equals",
       "path": "comparison.mode",
       "value": "compare"
      },
      {
       "op": "kind_of",
       "path": "comparison.reference.scenario",
       "kind": "party"
      }
     ]
    },
    "choices": [
     "support_share"
    ],
    "default": [
     "support_share"
    ],
    "limits": {},
    "multiple": true
   },
   {
    "path": "filters",
    "label": "Only respondents where",
    "widget": "filter_list",
    "required": false,
    "tier": "more",
    "options": {
     "source": "fields",
     "params": {
      "use": "filter"
     }
    },
    "limits": {
     "max_items": 8,
     "max_values": 200
    },
    "multiple": false
   },
   {
    "path": "caste_clubbing",
    "label": "Club small castes",
    "widget": "toggle",
    "required": false,
    "tier": "more",
    "show_when": {
     "op": "contains",
     "path": "cuts",
     "value": "caste"
    },
    "default": false,
    "limits": {},
    "multiple": false
   },
   {
    "path": "pipe_rounds",
    "label": "Rounds to show",
    "help": "The last N pipe rounds up to the anchor; empty = all of them",
    "widget": "number",
    "required": false,
    "tier": "more",
    "show_when": {
     "op": "equals",
     "path": "comparison.mode",
     "value": "trend"
    },
    "limits": {
     "min": 1
    },
    "multiple": false
   },
   {
    "path": "display_parties",
    "label": "Show only these parties",
    "help": "Hides rows after calculation; bases are unchanged",
    "widget": "party_picker",
    "required": false,
    "tier": "more",
    "options": {
     "source": "parties",
     "params": {
      "use": "hide"
     }
    },
    "limits": {},
    "multiple": true
   }
  ],
  "meta": {
   "family": "distribution",
   "lenses": [
    {
     "id": "support_share",
     "label": "Support %",
     "unit": "percentage",
     "has_delta": true
    },
    {
     "id": "composition_share",
     "label": "Population share %",
     "unit": "percentage",
     "has_delta": false
    },
    {
     "id": "contribution_share",
     "label": "Contribution %",
     "unit": "percentage",
     "has_delta": false
    },
    {
     "id": "scenario_composition_share",
     "label": "Scenario share %",
     "unit": "percentage",
     "has_delta": false
    },
    {
     "id": "joint_share",
     "label": "Joint %",
     "unit": "percentage",
     "has_delta": false
    },
    {
     "id": "size_of_impact_pp",
     "label": "Impact pp",
     "unit": "percentage_points",
     "has_delta": true
    }
   ],
   "default_lens": "support_share",
   "capabilities": {
    "modes": [
     "standalone",
     "compare",
     "trend"
    ],
    "transpose": true,
    "sort": true,
    "details": true
   }
  }
 },
